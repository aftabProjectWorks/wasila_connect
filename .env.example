# Environment variables required for local development and production

# Supabase (client)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase (server/service role) - KEEP SECRET
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Application secret for server-side signing/webhooks
APP_SECRET=

# Google OAuth (for Supabase Auth provider configuration)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Razorpay (disabled by default - required to enable production payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Notification provider placeholder
NOTIFY_PROVIDER_API_KEY=

NODE_ENV=development
